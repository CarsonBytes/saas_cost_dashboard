# Same Supabase project quant/study/event-radar already use.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional -- defaults to 8095
PORT=8095

# Daily cost threshold that triggers the alert banner + Telegram push.
ALERT_DAILY_COST_USD=0.50

# How often the background (no-browser-needed) alert check runs, in seconds.
ALERT_CHECK_INTERVAL_SEC=900

# Optional -- governance background-loop cadences, in seconds. Risk ledger
# scans HIGH/MEDIUM impact agents for injection patterns (dormant until
# llm_calls gains an input_text column); the compliance radar enforces rule
# deadlines and matches rules against the compliance snapshot source.
RISK_LEDGER_INTERVAL_SEC=300
COMPLIANCE_INTERVAL_SEC=600

# Optional -- URL of a JSON document describing the current regulatory
# posture (e.g. {"impact_level": "high", "affected_articles": ["Article 5"]}).
# The compliance engine fetches it each cycle and matches rules against it
# deterministically. Unset = no source, matching stays dormant. RegTech
# Radar will expose this endpoint when it regresses to a reachable host.
# REGULATORY_SOURCE=https://regtech-private.carsonng.com/api/compliance.json

# Same bot/chat as D:\quant\analyst\.env -- reuse those credentials so cost
# alerts land in the same Telegram chat as quant's own [PAPER]/[LIVE] alerts.
# Leave unset to disable the Telegram push (banner still works).
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Telegram control plane (Phase 5 A2, OPT-IN): a DEDICATED bot token that
# enables replying to alerts with /unlock /status /mute. Must be its own bot
# -- getUpdates long-poll 409-conflicts with any other consumer of the same
# token (the alert bot may be shared with quant; and a dev instance would
# fight the deployed container). Unset = control plane off.
TELEGRAM_COMMAND_BOT_TOKEN=

# Optional -- NOC "blocked by: LLM API" badge. The shared LLM API base URL the
# monitored agents call; probed for reachability to decide whether a failure is
# explained by a down dependency. Defaults to the shared chatanywhere endpoint
# all three monitored writers use.
LLM_API_BASE_URL=https://api.chatanywhere.tech/v1

# Optional -- NOC restart proxy endpoint (see the restart-proxy service in
# docker-compose.yml; the only component that holds the Docker socket). Only
# needed if you run the proxy somewhere other than the default compose-internal
# address.
RESTART_PROXY_URL=http://restart-proxy:8096

# Required for the manual Quarantine (pause) / Resume actions to work at all
# (FIXED 2026-08-17: neither action had any authentication -- the dashboard
# is public with no Cloudflare Access, so anyone could pause a live trading
# agent's container in two clicks). Unset = both actions stay disabled,
# fails closed rather than silently skipping the check.
NOC_ACTION_PASSCODE=your-shared-passcode
