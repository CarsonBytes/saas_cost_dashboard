# Same Supabase project quant/study/event-radar already use.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional -- defaults to 8095
PORT=8095

# Daily cost threshold that triggers the alert banner + Telegram push.
ALERT_DAILY_COST_USD=0.50

# How often the background (no-browser-needed) alert check runs, in seconds.
ALERT_CHECK_INTERVAL_SEC=900

# Optional -- governance background-loop cadences, in seconds. Risk ledger
# scans HIGH/MEDIUM impact agents for injection patterns (dormant until
# llm_calls gains an input_text column); the compliance radar enforces rule
# deadlines and matches rules against the (currently unwired) compliance
# snapshot source.
RISK_LEDGER_INTERVAL_SEC=300
COMPLIANCE_INTERVAL_SEC=600

# Same bot/chat as D:\quant\analyst\.env -- reuse those credentials so cost
# alerts land in the same Telegram chat as quant's own [PAPER]/[LIVE] alerts.
# Leave unset to disable the Telegram push (banner still works).
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Optional -- NOC "blocked by: LLM API" badge. The shared LLM API base URL the
# monitored agents call; probed for reachability to decide whether a failure is
# explained by a down dependency. Defaults to the shared chatanywhere endpoint
# all three monitored writers use.
LLM_API_BASE_URL=https://api.chatanywhere.tech/v1

# Optional -- NOC restart proxy endpoint (see the restart-proxy service in
# docker-compose.yml; the only component that holds the Docker socket). Only
# needed if you run the proxy somewhere other than the default compose-internal
# address.
RESTART_PROXY_URL=http://restart-proxy:8096
